@page "/sheet/{sheetName}"
@model BuildingMaintainerWebApp.Pages.SheetModel
@{
    ViewData["Title"] = Model.SheetName;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Building Maintainer</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body { padding: 20px; }
        .container { margin-top: 20px; }
        .table-responsive { margin-top: 20px; }
    </style>
</head>
<body>
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.SheetName</li>
            </ol>
        </nav>

        <h1 class="text-center my-4">@Model.SheetName</h1>

        @if (Model.SheetData.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            @foreach (var header in Model.Headers)
                            {
                                <th>@header</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.SheetData)
                        {
                            <tr>
                                @foreach (var header in Model.Headers)
                                {
                                    <td>@row.GetValueOrDefault(header)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                No data found in this sheet.
            </div>
        }
    </div>
</body>
</html>
