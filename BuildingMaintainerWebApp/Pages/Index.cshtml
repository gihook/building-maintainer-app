@page
@model BuildingMaintainerWebApp.Pages.IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Building Maintainer</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body { padding: 20px; }
        .container { max-width: 800px; margin-top: 50px; }
        .sheet-list { margin-top: 20px; }
        .admin-links { margin-top: 40px; }
    </style>
</head>
<body>
    <div class="container text-center">
        <h1 class="display-4">Building Maintainer</h1>
        <hr />
        
        <div class="sheet-list">
            <h3>Available Sheets</h3>
            <div class="list-group mt-3">
                @foreach (var sheetName in Model.SheetNames)
                {
                    <a href="/sheet/@sheetName.Replace(" ", "-")" class="list-group-item list-group-item-action">@sheetName</a>
                }
            </div>
        </div>
        
        <div class="admin-links">
            <hr />
            <h3>Admin & External Links</h3>
            <div class="mt-3">
                <a href="/hangfire" class="btn btn-outline-primary m-2">Hangfire Dashboard</a>
                <a href="https://docs.google.com/spreadsheets/d/1xPlu-1DTmw8O0vx0AygsHMJ-9ybOghzKzRT3nThTLg0" target="_blank" class="btn btn-outline-success m-2">Google Spreadsheet</a>
            </div>
        </div>
    </div>
</body>
</html>
